# .gitattributes_global
# 모든 텍스트 파일 기본값: repo에는 LF 저장, Windows checkout 시 CRLF 자동 변환
* text=auto eol=lf

# Windows 전용 스크립트 파일들 (Windows 실행 안정성을 위해 CRLF 강제)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ahk text eol=crlf

# 쉘 스크립트 및 Unix 계열 설정 파일 (반드시 LF)
*.sh text eol=lf
*.bash* text eol=lf
*.zsh* text eol=lf
*.fish text eol=lf
*.alias text eol=lf
.bashrc text eol=lf
.zshrc text eol=lf
.vimrc text eol=lf

# 프로그래밍 및 데이터 파일 (크로스플랫폼 표준 LF)
*.py text eol=lf
*.lua text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# SSH 및 인증 파일 (줄바꿈 혼용 시 인증 실패 방지를 위해 LF 고정)
id_* text eol=lf
known_hosts text eol=lf
authorized_keys text eol=lf
config text eol=lf
credentials text eol=lf

# 이미지, 바이너리, 압축 파일 등 (변환 절대 금지)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.7z binary
*.rar binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Git LFS 설정 (필요 시 주석 해제)
