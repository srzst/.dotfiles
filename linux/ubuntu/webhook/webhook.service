[Unit]
Description=GitHub Webhook Listener
After=network.target

[Service]
Type=simple
User=x
ExecStart=/bin/bash -c 'source /home/x/.bashrc_secrets && exec /usr/bin/python3 /home/x/.dotfiles/linux/ubuntu/webhook/webhook_listener.py'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
